# =============================================================================
# paysafe-migration-oracle — environment variable template
# Copy to .env and fill in the required values before running.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — container will exit immediately if these are absent or empty
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687          # REQUIRED — Bolt URI of your Neo4j instance
NEO4J_PASSWORD=                      # REQUIRED — Neo4j user password

# -----------------------------------------------------------------------------
# Graph Database (optional)
# -----------------------------------------------------------------------------
NEO4J_USERNAME=neo4j                 # Neo4j username (default: neo4j)
SSL_VERIFY=true                      # Verify TLS on outbound HTTP calls (true/false)

# -----------------------------------------------------------------------------
# AI Model Provider (optional)
# At least one API key is required when MODEL_PROVIDER is not ollama/litellm.
# -----------------------------------------------------------------------------
MODEL_PROVIDER=anthropic             # anthropic | openai | ollama | litellm
MODEL_ID=                            # Required for the filter/entity LLM steps, e.g. claude-opus-5-5
ANTHROPIC_API_KEY=                   # Required when MODEL_PROVIDER=anthropic
OPENAI_API_KEY=                      # Required when MODEL_PROVIDER=openai
OPENAI_BASE_URL=                     # Custom OpenAI-compatible base URL (empty = official endpoint)
LITELLM_BASE_URL=                    # LiteLLM proxy base URL
OLLAMA_HOST=http://localhost:11434   # Ollama server address
AWS_REGION=eu-central-1             # AWS region for Bedrock model access

# -----------------------------------------------------------------------------
# External Integrations (optional)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=                        # GitHub token for release note extraction
GITLAB_API_KEY=                      # GitLab API key for changelog access
FINDIT_AUTH_TOKEN=                   # Paysafe FindIt service authentication token
FINDIT_BASE_URL=https://findit-api.icd.paysafe.cloud  # Paysafe FindIt API base URL

# -----------------------------------------------------------------------------
# MCP Server (optional)
# Set by image — do not override: MCP_TRANSPORT=sse, MCP_HOST=0.0.0.0
# -----------------------------------------------------------------------------
MIGRATION_MODE=lite                  # lite (4 tools) | full (24 tools, four-loop harness)
MCP_PORT=8080                        # Port the MCP SSE server listens on
# MCP_TRANSPORT=sse                  # Set by image — do not override
# MCP_HOST=0.0.0.0                   # Set by image — do not override
MCP_STATELESS_HTTP=false             # Enable stateless HTTP mode (leave as default for SSE)

# -----------------------------------------------------------------------------
# Streamlit UI (optional)
# -----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501           # Port Streamlit listens on

# -----------------------------------------------------------------------------
# Embedding Model (optional)
# WARNING: changing SENTENCE_TRANSFORMERS_MODEL at runtime to a value different
# from the build-time ARG will trigger a cold model download on first use,
# violating the zero-cold-start guarantee.
# Set by image — SENTENCE_TRANSFORMERS_MODEL is baked in at build time.
# HF_HOME is set by image — do not override.
# -----------------------------------------------------------------------------
SENTENCE_TRANSFORMERS_MODEL=all-mpnet-base-v2  # Must match build-time ARG value

# -----------------------------------------------------------------------------
# Observability & Tuning (optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
ARTIFACT_CACHE_DIR=./artifacts              # Local dir for extracted migration artifact caching
EXTRACTION_RATE_LIMIT_RETRIES=3             # Max retries on rate-limited extraction requests
EXTRACTION_RETRY_BASE_DELAY=2.0            # Base backoff delay in seconds
JIRA_MAX_CONCURRENT=4                      # Max concurrent Jira API requests
REDHAT_DOCS_DELAY_SEC=2.0                  # Delay between Red Hat docs scrape requests
FINDIT_SERVICE_NAME_FUZZY_THRESHOLD=0.68   # Fuzzy match threshold for FindIt service name resolution
JBOSS_SKIP_PRERELEASE=1                    # Skip pre-release versions when scanning JBoss/WildFly
SPRING_INCLUDE_PRERELEASE=1                # Include pre-release versions when scanning Spring
HOP_GRANULARITY=minor                      # Ingestion hop step size: minor (X.Y.0 per line, default) | patch (every release)
HOP_BY_HOP=0                               # 1 = filter/entity LLM + graph population run once per version hop

# -----------------------------------------------------------------------------
# System-1 change triage (optional)
# Triage runs only when BOTH TRIAGE_BASE_URL and TRIAGE_MODEL are non-empty.
# Leave either empty to keep every raw row and the historical 4-column table.
# -----------------------------------------------------------------------------
TRIAGE_BASE_URL=                           # e.g. http://gpuserver1.neterra.skrill.net:8002
TRIAGE_ENDPOINT_PATH=/v1/systemone         # Joined onto TRIAGE_BASE_URL
TRIAGE_MODEL=                              # e.g. nimble
TRIAGE_API_KEY=                            # Bearer token, only sent when set
TRIAGE_TIMEOUT_SEC=30                      # Per-request timeout
TRIAGE_MAX_CONCURRENT=2                    # Parallel classifier calls
TRIAGE_STATE_MAX_CHARS=6000                # Cap on the per-row state string
TRIAGE_DROP_MAX_ACTION_PROB=0.10           # Drop only below this P(action)
TRIAGE_DROP_MIN_CATEGORY_PROB=0.80         # Drop only at or above this category probability
TRIAGE_DROP_MAX_IMPACT_SCORE=1.0           # Drop only below this impact score
FILTER_MAX_INPUT_TOKENS=60000              # Split the filter call by category above this size

# -----------------------------------------------------------------------------
# Per-change research (optional)
# Research runs when RESEARCH_BASE_URL and RESEARCH_MODEL_ID are non-empty.
# Leave either empty to keep the entity step on filtered Markdown alone.
# TAVILY_API_KEY is optional: without it the model has no web_search and reads
# the row Sources and linked pages with fetch_url only.
# -----------------------------------------------------------------------------
RESEARCH_BASE_URL=                         # e.g. http://gpuserver2.neterra.skrill.net:8010/v1
RESEARCH_MODEL_ID=                         # e.g. /models/Qwen3.6
RESEARCH_API_KEY=                          # Bearer token, only sent when set
RESEARCH_ENABLE_THINKING=false             # chat_template_kwargs.enable_thinking
RESEARCH_MAX_CONCURRENT=4                  # Parallel research rows
RESEARCH_MAX_TOOL_CALLS=8                  # Tool calls allowed for one row
RESEARCH_TIMEOUT_SEC=240                   # Per-row budget for the whole tool loop
RESEARCH_MODEL_TIMEOUT_SEC=60              # Per-request timeout for one model call
RESEARCH_SEARCH_RESULTS=5                  # Tavily hits per search
RESEARCH_FETCH_MAX_CHARS=20000             # Cap on fetched page text
RESEARCH_SHARED_URL_MAX_ROWS=3             # Ignore Source URLs shared by more raw rows than this
RESEARCH_RAW_CONTEXT_MAX_CHARS=8000        # Cap on raw statements attached to one row
TAVILY_API_KEY=                            # Tavily Search key. Empty = fetch_url only, no web_search
ENTITY_MAX_INPUT_TOKENS=60000              # Split the entity call by section above this size
# PYTHONUNBUFFERED=1                       # Set by image — do not override
