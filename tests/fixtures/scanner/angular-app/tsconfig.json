{
  // Base config; the app and spec configs extend this one.
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@app/*": ["src/app/*"],
      "@env/*": ["src/environments/*"],
      "@shared": ["src/app/shared/index.ts"],
    },
    /* Angular's own compiler options. */
    "types": ["node"],
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "typeCheckHostBindings": true,
  },
}
